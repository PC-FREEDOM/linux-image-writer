msgid ""
msgstr ""
"Project-Id-Version: linux-image-writer 0.1.0\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2026-10-04 11:12+0900\n"
"PO-Revision-Date: 2026-10-02 00:00+0900\n"
"Last-Translator: PC-FREEDOM\n"
"Language-Team: Japanese\n"
"Language: ja\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

#: src/bin/linux-image-writer/text.rs:25
#, rust-format
msgid "{bytes} byte"
msgid_plural "{bytes} bytes"
msgstr[0] "{bytes} バイト"

#: src/bin/linux-image-writer/text.rs:51
#, rust-format
msgid "{done} / {total} byte"
msgid_plural "{done} / {total} bytes"
msgstr[0] "{done} / {total} バイト"

#: src/bin/linux-image-writer/text.rs:86
msgid "Uncompressed image"
msgstr "非圧縮イメージ"

#: src/bin/linux-image-writer/text.rs:87
msgid "GZIP-compressed image"
msgstr "GZIP 圧縮イメージ"

#: src/bin/linux-image-writer/text.rs:88
msgid "XZ-compressed image"
msgstr "XZ 圧縮イメージ"

#: src/bin/linux-image-writer/text.rs:111
msgid "File not found"
msgstr "ファイルが見つかりません"

#: src/bin/linux-image-writer/text.rs:112
msgid "No permission to read the file"
msgstr "ファイルを読み取る権限がありません"

#: src/bin/linux-image-writer/text.rs:113
msgid "The file could not be read"
msgstr "ファイルを読み取れませんでした"

#: src/bin/linux-image-writer/text.rs:116
msgid "Not a regular file (folders and devices cannot be chosen)"
msgstr "通常のファイルではありません（フォルダーやデバイスは選べません）"

#: src/bin/linux-image-writer/text.rs:119
#, rust-format
msgid "{format}-compressed files are not supported"
msgstr "{format} 形式の圧縮ファイルには対応していません"

#: src/bin/linux-image-writer/text.rs:123
#, rust-format
msgid ""
"The file name indicates {format} compression, but the contents do not match"
msgstr "ファイル名は {format} 圧縮を示していますが、内容が一致しません"

#: src/bin/linux-image-writer/text.rs:133
msgid "Unknown connection"
msgstr "接続方式不明"

#: src/bin/linux-image-writer/text.rs:148
msgid "Unnamed device"
msgstr "名前のないデバイス"

#: src/bin/linux-image-writer/text.rs:157
msgid "It is a system disk."
msgstr "システムのディスクです。"

#: src/bin/linux-image-writer/text.rs:158
msgid "It is in use by the system (/, /boot or similar)."
msgstr "システム領域（/ や /boot など）が使用しています。"

#: src/bin/linux-image-writer/text.rs:159
msgid "It is in use as swap."
msgstr "スワップとして使用中です。"

#: src/bin/linux-image-writer/text.rs:160
msgid "It is part of an LVM, RAID or encrypted setup."
msgstr "LVM・RAID・暗号化などの構成に含まれています。"

#: src/bin/linux-image-writer/text.rs:161
msgid "It is mounted."
msgstr "マウントされています。"

#: src/bin/linux-image-writer/text.rs:162
msgid "It is read-only."
msgstr "読み取り専用です。"

#: src/bin/linux-image-writer/text.rs:163
msgid "The system has set it to be hidden."
msgstr "システムが非表示に設定しています。"

#: src/bin/linux-image-writer/text.rs:164
msgid "It is a device that cannot be partitioned."
msgstr "パーティションを作成できないデバイスです。"

#: src/bin/linux-image-writer/text.rs:165
msgid "It is a removable USB device."
msgstr "USB のリムーバブルデバイスです。"

#: src/bin/linux-image-writer/text.rs:167
msgid "It could not be confirmed to be a removable USB device."
msgstr "USB のリムーバブルデバイスと確認できません。"

#: src/bin/linux-image-writer/text.rs:169
msgid "No media is inserted."
msgstr "メディアが挿入されていません。"

#: src/bin/linux-image-writer/text.rs:182
#, rust-format
msgid "{sentences} {next_sentence}"
msgstr "{sentences}{next_sentence}"

#: src/bin/linux-image-writer/text.rs:186
msgid "It cannot be chosen, for safety."
msgstr "安全のため選択できません。"

#: src/bin/linux-image-writer/text.rs:203
msgid "No USB drive found"
msgstr "USB ドライブが見つかりません"

#: src/bin/linux-image-writer/text.rs:204
msgid "Connect the USB drive to write to"
msgstr "書き込み先の USB ドライブを接続してください"

#: src/bin/linux-image-writer/text.rs:207
msgid "The connected USB drive is in use and cannot be chosen"
msgstr "接続されている USB ドライブは使用中のため選べません"

#: src/bin/linux-image-writer/text.rs:208
msgid "Unmount it in your file manager, then try again"
msgstr "ファイルマネージャーでマウントを解除してから、もう一度お試しください"

#: src/bin/linux-image-writer/text.rs:211
msgid "The connected USB drive cannot be chosen as the target"
msgstr "接続されている USB ドライブは書き込み先に選べません"

#: src/bin/linux-image-writer/text.rs:212
msgid "See “Protected devices” for the reason"
msgstr "理由は「保護されているデバイス」で確認できます"

#: src/bin/linux-image-writer/text.rs:222
msgid ""
"Another image cannot be opened while processing. Try again once it has "
"finished"
msgstr ""
"処理中のため、別のイメージは開けません。処理が終わってから、もう一度お試しく"
"ださい"

#: src/bin/linux-image-writer/text.rs:224
msgid "Close the result view, then try again"
msgstr "結果画面を閉じてから、もう一度お試しください"

#: src/bin/linux-image-writer/text.rs:230
msgid "The device list could not be read"
msgstr "デバイスの一覧を取得できませんでした"

#: src/bin/linux-image-writer/text.rs:238
msgid "The selected USB drive can no longer be found. Choose the target again."
msgstr ""
"選択していた USB ドライブが見つからなくなりました。書き込み先を選び直してくだ"
"さい。"

#: src/bin/linux-image-writer/text.rs:241
msgid ""
"The selected USB drive cannot be chosen at the moment. Choose the target "
"again."
msgstr ""
"選択していた USB ドライブは現在選択できません。書き込み先を選び直してくださ"
"い。"

#: src/bin/linux-image-writer/text.rs:244
msgid ""
"The selected USB drive is too small for this image. Choose the target again."
msgstr ""
"選択していた USB ドライブはこのイメージには容量が足りません。書き込み先を選び"
"直してください。"

#: src/bin/linux-image-writer/text.rs:254
msgid "Quick verification"
msgstr "クイック検証"

#: src/bin/linux-image-writer/text.rs:255
msgid "Full verification"
msgstr "完全検証"

#: src/bin/linux-image-writer/text.rs:256
msgid "No verification"
msgstr "検証なし"

#: src/bin/linux-image-writer/text.rs:262
msgid "After writing, part of the data is read back and checked."
msgstr "書き込み後、一部を読み戻して確認します。"

#: src/bin/linux-image-writer/text.rs:264
msgid ""
"All of the written data is read back and checked.\n"
"This takes longer than quick verification."
msgstr ""
"書き込んだデータをすべて読み戻して確認します。\n"
"クイック検証より時間がかかります。"

#: src/bin/linux-image-writer/text.rs:266
msgid "The written data is not read back and checked."
msgstr "書き込み後の読み戻し確認は行われません。"

#: src/bin/linux-image-writer/text.rs:279
msgid "Not available for this image"
msgstr "このイメージでは利用できません"

#: src/bin/linux-image-writer/text.rs:287
msgid ""
"Images in this format cannot be read from an arbitrary position, so quick "
"verification, which reads back parts of the image, is not available"
msgstr ""
"この形式のイメージは任意の位置から読み取れないため、一部を読み戻すクイック検"
"証は利用できません"

#: src/bin/linux-image-writer/text.rs:296
msgid ""
"Based on the image format. Verification itself can still fail when it runs, "
"depending on the state of the device"
msgstr ""
"イメージの形式による判定です。検証そのものは、実行時にデバイスの状態によって"
"失敗することがあります"

#: src/bin/linux-image-writer/text.rs:308
#, rust-format
msgid "{wanted} is not available for this image, so it was changed to {used}"
msgstr "このイメージでは{wanted}を利用できないため、{used}に変更しました"

#: src/bin/linux-image-writer/text.rs:321
#, rust-format
msgid "Not enough capacity: {size} more is needed"
msgstr "容量が {size} 不足しています"

#: src/bin/linux-image-writer/text.rs:328
msgid "Choose an image to write"
msgstr "書き込むイメージを選択してください"

#: src/bin/linux-image-writer/text.rs:329
#: src/bin/linux-image-writer/text.rs:408
#: src/bin/linux-image-writer/window.rs:680
msgid "Checking the image…"
msgstr "イメージを確認しています…"

#: src/bin/linux-image-writer/text.rs:330
#: src/bin/linux-image-writer/window.rs:753
#: src/bin/linux-image-writer/window.rs:1343
msgid "This image cannot be written"
msgstr "このイメージは書き込めません"

#: src/bin/linux-image-writer/text.rs:332
msgid "The device list could not be read, so the target cannot be checked"
msgstr "デバイスの一覧を取得できないため、書き込み先を確認できません"

#: src/bin/linux-image-writer/text.rs:334
#: src/bin/linux-image-writer/window.rs:1033
msgid "Choose the USB drive to write to"
msgstr "書き込み先の USB ドライブを選択してください"

#: src/bin/linux-image-writer/text.rs:335
msgid "This verification mode is not available"
msgstr "この検証方法は利用できません"

#: src/bin/linux-image-writer/text.rs:344
msgid "Prepare"
msgstr "準備"

#: src/bin/linux-image-writer/text.rs:345
msgid "Write"
msgstr "書き込み"

#: src/bin/linux-image-writer/text.rs:346
msgid "Verify"
msgstr "検証"

#: src/bin/linux-image-writer/text.rs:352
msgid "Waiting"
msgstr "待機中"

#: src/bin/linux-image-writer/text.rs:353
#: src/bin/linux-image-writer/window.rs:2288
msgid "Running"
msgstr "実行中"

#: src/bin/linux-image-writer/text.rs:354
#: src/bin/linux-image-writer/text.rs:552
#: src/bin/linux-image-writer/text.rs:651
msgid "Done"
msgstr "完了"

#: src/bin/linux-image-writer/text.rs:356
#: src/bin/linux-image-writer/text.rs:556
#: src/bin/linux-image-writer/window.rs:963
msgid "None"
msgstr "なし"

#: src/bin/linux-image-writer/text.rs:357
#: src/bin/linux-image-writer/text.rs:557
msgid "Cancelled"
msgstr "中止"

#: src/bin/linux-image-writer/text.rs:358
#: src/bin/linux-image-writer/text.rs:569
msgid "Failed"
msgstr "失敗"

#: src/bin/linux-image-writer/text.rs:378
#: src/bin/linux-image-writer/text.rs:498
msgid "Cancelling"
msgstr "中止しています"

#: src/bin/linux-image-writer/text.rs:381
msgid "Preparing to Write"
msgstr "書き込みを準備しています"

#: src/bin/linux-image-writer/text.rs:382
#: src/bin/linux-image-writer/text.rs:504
msgid "Finishing the Write"
msgstr "書き込みを仕上げています"

#: src/bin/linux-image-writer/text.rs:383
msgid "Writing to USB"
msgstr "USB に書き込んでいます"

#: src/bin/linux-image-writer/text.rs:385
msgid "Checking All of the Written Data"
msgstr "書き込んだデータをすべて確認しています"

#: src/bin/linux-image-writer/text.rs:386
msgid "Checking the Written Data"
msgstr "書き込んだデータを確認しています"

#: src/bin/linux-image-writer/text.rs:393
msgid "Nothing has been written to the USB drive yet."
msgstr "まだ USB ドライブには書き込んでいません。"

#: src/bin/linux-image-writer/text.rs:394
msgid "Do not remove the USB drive."
msgstr "USB ドライブを取り外さないでください。"

#: src/bin/linux-image-writer/text.rs:402
msgid "Please wait until it stops."
msgstr "処理が止まるまでお待ちください。"

#: src/bin/linux-image-writer/text.rs:405
msgid "If the system asks you to authenticate, complete the authentication."
msgstr "システムの認証画面が表示された場合は、認証を完了してください。"

#: src/bin/linux-image-writer/text.rs:407
#: src/bin/linux-image-writer/window.rs:2116
msgid "Checking the target…"
msgstr "書き込み先を確認しています…"

#: src/bin/linux-image-writer/text.rs:409
msgid "Checking the compressed image…"
msgstr "圧縮イメージを確認しています…"

#: src/bin/linux-image-writer/text.rs:411
msgid "Waiting for the final confirmation…"
msgstr "最終確認を待っています…"

#: src/bin/linux-image-writer/text.rs:413
msgid "Starting to write…"
msgstr "書き込みを開始しています…"

#: src/bin/linux-image-writer/text.rs:415
msgid "Opening the USB drive…"
msgstr "USB ドライブを開いています…"

#: src/bin/linux-image-writer/text.rs:418
msgid "Opening the USB drive for verification…"
msgstr "検証のために USB ドライブを開いています…"

#: src/bin/linux-image-writer/text.rs:422
msgid "Decompressing and writing"
msgstr "展開しながら書き込み中"

#: src/bin/linux-image-writer/text.rs:424
msgid "Writing"
msgstr "書き込み中"

#: src/bin/linux-image-writer/text.rs:426
msgid "Waiting for the USB drive to finish writing…"
msgstr "USB ドライブの書き込み完了を待っています…"

#: src/bin/linux-image-writer/text.rs:429
msgid "Preparing verification…"
msgstr "検証の準備をしています…"

#: src/bin/linux-image-writer/text.rs:432
msgid "Full verification in progress"
msgstr "完全検証中"

#: src/bin/linux-image-writer/text.rs:433
msgid "Checking all of the written data."
msgstr "書き込んだデータをすべて確認しています。"

#: src/bin/linux-image-writer/text.rs:436
msgid "Quick verification in progress"
msgstr "クイック検証中"

#: src/bin/linux-image-writer/text.rs:437
msgid "Checking the written data."
msgstr "書き込んだデータを確認しています。"

#: src/bin/linux-image-writer/text.rs:459
msgid "Safely stopping the write"
msgstr "書き込みを安全に終了しています"

#: src/bin/linux-image-writer/text.rs:466
#, rust-format
msgid "Written to the USB drive: {amount}"
msgstr "USB に書き込み済み: {amount}"

#: src/bin/linux-image-writer/text.rs:470
#, rust-format
msgid ""
"Waiting for the USB drive to confirm the first data ({size} read from the "
"image)"
msgstr "USB への書き込みの確認を待っています（イメージから {size} 読み込み済み）"

#: src/bin/linux-image-writer/text.rs:481
msgid "Confirming the write to the USB drive"
msgstr "USB への書き込みを確定しています"

#: src/bin/linux-image-writer/text.rs:485
#, rust-format
msgid "Checking: {amount}"
msgstr "確認中: {amount}"

#: src/bin/linux-image-writer/text.rs:499
msgid ""
"The write to the USB drive is being stopped safely. The window cannot be "
"closed until it has finished."
msgstr "USB への書き込みを安全に終了しています。完了するまで、ウィンドウは閉じられません。"

#: src/bin/linux-image-writer/text.rs:505
msgid ""
"Confirming the write to the USB drive. The window cannot be closed until "
"this is complete."
msgstr "USB への書き込みを確定しています。完了するまで、ウィンドウは閉じられません。"

#: src/bin/linux-image-writer/text.rs:509
msgid "Writing in Progress"
msgstr "書き込み処理の実行中です"

#: src/bin/linux-image-writer/text.rs:510
msgid ""
"The window cannot be closed until it has finished. To stop, press “Cancel”."
msgstr ""
"処理が終わるまで、ウィンドウは閉じられません。中止する場合は「キャンセル」を"
"押してください。"

#: src/bin/linux-image-writer/text.rs:518
msgid "Complete"
msgstr "完了しました"

#: src/bin/linux-image-writer/text.rs:519
msgid "Writing Complete"
msgstr "書き込みが完了しました"

#: src/bin/linux-image-writer/text.rs:520
msgid "Writing Is Complete"
msgstr "書き込みは完了しています"

#: src/bin/linux-image-writer/text.rs:521
msgid "Verification Found a Problem"
msgstr "検証で問題が見つかりました"

#: src/bin/linux-image-writer/text.rs:522
msgid "Verification Could Not Be Completed"
msgstr "検証を完了できませんでした"

#: src/bin/linux-image-writer/text.rs:523
msgid "Writing Could Not Be Completed"
msgstr "書き込みを完了できませんでした"

#: src/bin/linux-image-writer/text.rs:525
msgid "Writing Cancelled"
msgstr "書き込みを中止しました"

#: src/bin/linux-image-writer/text.rs:527
msgid "Writing Could Not Start"
msgstr "書き込みを開始できませんでした"

#: src/bin/linux-image-writer/text.rs:528
msgid "The Write Operation Could Not Be Completed"
msgstr "書き込み処理を完了できませんでした"

#: src/bin/linux-image-writer/text.rs:550
msgid "Full verification done"
msgstr "完全検証完了"

#: src/bin/linux-image-writer/text.rs:551
msgid "Quick verification done"
msgstr "クイック検証完了"

#: src/bin/linux-image-writer/text.rs:555
msgid "Not run"
msgstr "未実施"

#: src/bin/linux-image-writer/text.rs:559
msgid "Mismatch"
msgstr "不一致"

#: src/bin/linux-image-writer/text.rs:562
#: src/bin/linux-image-writer/text.rs:567
msgid "Not completed"
msgstr "完了できず"

#: src/bin/linux-image-writer/text.rs:564
#: src/bin/linux-image-writer/text.rs:568
msgid "Could not start"
msgstr "開始できず"

#: src/bin/linux-image-writer/text.rs:600
msgid ""
"The USB drive may contain an incomplete image. Do not use it as a boot drive."
msgstr ""
"USB ドライブには不完全なイメージが残っている可能性があります。起動用の USB ド"
"ライブとして使用しないでください。"

#: src/bin/linux-image-writer/text.rs:601
msgid "Nothing was written to the USB drive."
msgstr "USB ドライブには何も書き込んでいません。"

#: src/bin/linux-image-writer/text.rs:603
msgid "The USB drive is ready to use."
msgstr "USB ドライブを使用できます。"

#: src/bin/linux-image-writer/text.rs:604
msgid "The written data was not verified."
msgstr "書き込み後の検証は行っていません。"

#: src/bin/linux-image-writer/text.rs:605
msgid "Verification of the written data was not completed."
msgstr "書き込み後の検証は完了していません。"

#: src/bin/linux-image-writer/text.rs:607
msgid ""
"Writing finished, but the data read back did not match the image. It may not "
"have been written correctly, so using this USB drive as a boot drive is not "
"recommended."
msgstr ""
"書き込みは完了しましたが、読み戻したデータがイメージと一致しませんでした。正"
"しく書き込まれていない可能性があるため、この USB ドライブを起動用として使用す"
"ることはおすすめしません。"

#: src/bin/linux-image-writer/text.rs:611
msgid "Writing is complete, but verification could not be completed."
msgstr "書き込みは完了していますが、検証を完了できませんでした。"

#: src/bin/linux-image-writer/text.rs:633
msgid "Writing to the USB drive was not started."
msgstr "USB ドライブへの書き込みは開始されていません。"

#: src/bin/linux-image-writer/text.rs:637
msgid "The operation ended because of an internal error."
msgstr "内部エラーで処理が終了しました。"

#: src/bin/linux-image-writer/text.rs:645
msgid "Safely Remove"
msgstr "安全に取り外す"

#: src/bin/linux-image-writer/text.rs:646
msgid "Try Again"
msgstr "もう一度試す"

#: src/bin/linux-image-writer/text.rs:647
msgid "Write to Another USB"
msgstr "別の USB に書き込む"

#: src/bin/linux-image-writer/text.rs:648
msgid "Write Again"
msgstr "もう一度書き込む"

#: src/bin/linux-image-writer/text.rs:649
msgid "Start Over"
msgstr "やり直す"

#: src/bin/linux-image-writer/text.rs:650
msgid "Back to Main View"
msgstr "メイン画面に戻る"

#: src/bin/linux-image-writer/text.rs:679
msgid "Safely removing the USB drive…"
msgstr "USB を安全に取り外しています…"

#: src/bin/linux-image-writer/text.rs:680
msgid "Do not unplug the USB drive yet."
msgstr "USB ドライブはまだ取り外さないでください。"

#: src/bin/linux-image-writer/text.rs:689
msgid "The USB drive can be safely removed"
msgstr "USB を安全に取り外せます"

#: src/bin/linux-image-writer/text.rs:691
#, rust-format
msgid "Unplug {name} from the computer."
msgstr "{name} をパソコンから取り外してください。"

#: src/bin/linux-image-writer/text.rs:692
msgid "Unplug the USB drive from the computer."
msgstr "USB ドライブをパソコンから取り外してください。"

#: src/bin/linux-image-writer/text.rs:694
msgid "Its filesystems were unmounted"
msgstr "ファイルシステムを終了しました"

#: src/bin/linux-image-writer/text.rs:697
msgid "USB drive not found"
msgstr "USB が見つかりません"

#: src/bin/linux-image-writer/text.rs:698
msgid "Make sure the USB drive is connected."
msgstr "USB ドライブが接続されていることを確認してください。"

#: src/bin/linux-image-writer/text.rs:701
msgid "The USB drive has changed"
msgstr "USB の状態が変わりました"

#: src/bin/linux-image-writer/text.rs:703
msgid ""
"It could not be confirmed to be the same device as when writing, so safe "
"removal was stopped."
msgstr ""
"書き込み時と同じデバイスであることを確認できなかったため、安全な取り外しを中"
"止しました。"

#: src/bin/linux-image-writer/text.rs:707
msgid "This USB drive cannot be safely removed from this app"
msgstr "この USB はアプリから安全に取り外せません"

#: src/bin/linux-image-writer/text.rs:708
msgid "Eject it from a file manager or similar instead."
msgstr "ファイルマネージャーなどから取り外してください。"

#: src/bin/linux-image-writer/text.rs:711
msgid "The USB drive could not be removed"
msgstr "USB を取り外せませんでした"

#: src/bin/linux-image-writer/text.rs:713
msgid ""
"The USB drive is being used by another app. Close any files or apps that use "
"it, then try again."
msgstr ""
"USB ドライブがほかのアプリで使用されています。使用中のファイルやアプリを閉じ"
"て、もう一度お試しください。"

#: src/bin/linux-image-writer/text.rs:717
msgid "Safe removal could not be performed"
msgstr "安全な取り外しを実行できませんでした"

#: src/bin/linux-image-writer/text.rs:719
msgid ""
"You are not allowed to do this. Eject the USB drive from a file manager or "
"similar instead."
msgstr ""
"この操作を実行する権限がありません。ファイルマネージャーなどから取り外してく"
"ださい。"

#: src/bin/linux-image-writer/text.rs:723
msgid "Safe removal could not be completed"
msgstr "安全な取り外しを完了できませんでした"

#: src/bin/linux-image-writer/text.rs:724
msgid ""
"Do not unplug the USB drive yet. Eject it from a file manager or similar "
"instead."
msgstr ""
"USB ドライブはまだ取り外さないでください。ファイルマネージャーなどから取り外"
"してください。"

#: src/bin/linux-image-writer/text.rs:758
msgid "The target USB drive was not found."
msgstr "書き込み先の USB ドライブが見つかりません。"

#: src/bin/linux-image-writer/text.rs:759
msgid "Information about the target USB drive could not be read."
msgstr "書き込み先の USB ドライブの情報を取得できませんでした。"

#: src/bin/linux-image-writer/text.rs:761
msgid ""
"The target USB drive could not be confirmed to be the same one that was "
"selected."
msgstr ""
"書き込み先の USB ドライブを、選択したものと同じだと確認できませんでした。"

#: src/bin/linux-image-writer/text.rs:764
msgid "The target USB drive cannot be chosen as the target at the moment."
msgstr "書き込み先の USB ドライブは、現在は書き込み先に選べません。"

#: src/bin/linux-image-writer/text.rs:766
msgid "The image file could not be read."
msgstr "イメージファイルを読み取れませんでした。"

#: src/bin/linux-image-writer/text.rs:767
msgid "This image cannot be written."
msgstr "このイメージは書き込めません。"

#: src/bin/linux-image-writer/text.rs:768
msgid "Quick verification is not available for this image."
msgstr "このイメージではクイック検証を利用できません。"

#: src/bin/linux-image-writer/text.rs:769
msgid "The compressed image is damaged or incomplete."
msgstr "圧縮イメージが壊れているか、不完全です。"

#: src/bin/linux-image-writer/text.rs:771
msgid ""
"The decompressed size is larger than the capacity of the target USB drive."
msgstr "展開後のサイズが、書き込み先の USB ドライブの容量を超えています。"

#: src/bin/linux-image-writer/text.rs:774
msgid ""
"This compressed image needs too many resources to decompress, so it cannot "
"be written."
msgstr "この圧縮イメージは、展開に必要な資源が多すぎるため書き込めません。"

#: src/bin/linux-image-writer/text.rs:776
msgid "The image file changed while it was being checked."
msgstr "確認中にイメージファイルが変更されました。"

#: src/bin/linux-image-writer/text.rs:778
msgid ""
"Writing was not started because it did not match the final confirmation."
msgstr "最終確認の内容と一致しなかったため、書き込みを開始しませんでした。"

#: src/bin/linux-image-writer/text.rs:781
msgid ""
"The check right before writing found a problem with the target USB drive."
msgstr ""
"書き込み直前の再確認で、書き込み先の USB ドライブに問題が見つかりました。"

#: src/bin/linux-image-writer/text.rs:783
msgid "Access to the USB drive was not allowed."
msgstr "USB ドライブへのアクセスが許可されませんでした。"

#: src/bin/linux-image-writer/text.rs:785
msgid "Authentication was cancelled, so the USB drive could not be opened."
msgstr "認証がキャンセルされたため、USB ドライブを開けませんでした。"

#: src/bin/linux-image-writer/text.rs:787
msgid "The USB drive could not be opened. It may be in use."
msgstr "USB ドライブを開けませんでした。使用中の可能性があります。"

#: src/bin/linux-image-writer/text.rs:789
msgid ""
"Could not communicate with the system's disk management service (UDisks2)."
msgstr "システムのディスク管理サービス（UDisks2）と通信できませんでした。"

#: src/bin/linux-image-writer/text.rs:792
msgid ""
"Writing was not started because the opened device could not be confirmed to "
"be the target."
msgstr ""
"開いたデバイスを書き込み先と同じだと確認できなかったため、書き込みを開始しま"
"せんでした。"

#: src/bin/linux-image-writer/text.rs:794
msgid "An error occurred while writing to the USB drive."
msgstr "USB ドライブへの書き込み中にエラーが発生しました。"

#: src/bin/linux-image-writer/text.rs:795
msgid "The image file changed during writing."
msgstr "書き込み中にイメージファイルが変更されました。"

#: src/bin/linux-image-writer/text.rs:797
msgid "The write could not be finished (the data could not be committed)."
msgstr "書き込みの仕上げ（データの確定）を完了できませんでした。"

#: src/bin/linux-image-writer/text.rs:800
msgid ""
"The check before verification could not confirm that the USB drive is the "
"same as the target."
msgstr ""
"検証の前の再確認で、USB ドライブを書き込み先と同じだと確認できませんでした。"

#: src/bin/linux-image-writer/text.rs:802
msgid "The USB drive could not be opened for verification."
msgstr "検証のために USB ドライブを開けませんでした。"

#: src/bin/linux-image-writer/text.rs:804
msgid ""
"Direct reading, which verification needs, is not available in this "
"environment."
msgstr "この環境では、検証に必要な直接読み取りを利用できませんでした。"

#: src/bin/linux-image-writer/text.rs:806
msgid "Verification did not start."
msgstr "検証が開始されませんでした。"

#: src/bin/linux-image-writer/text.rs:808
msgid ""
"The written data did not match the image. This USB drive may not have been "
"written correctly."
msgstr ""
"書き込んだデータがイメージと一致しませんでした。この USB ドライブは正しく書き"
"込まれていない可能性があります。"

#: src/bin/linux-image-writer/text.rs:810
msgid "An error occurred while reading back."
msgstr "読み戻し中にエラーが発生しました。"

#: src/bin/linux-image-writer/text.rs:811
msgid "The length of the data read back did not match."
msgstr "読み戻したデータの長さが一致しませんでした。"

#: src/bin/linux-image-writer/text.rs:838
msgid "Size"
msgstr "サイズ"

#: src/bin/linux-image-writer/text.rs:840
msgid "Format"
msgstr "形式"

#: src/bin/linux-image-writer/text.rs:842
