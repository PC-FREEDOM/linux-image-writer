# Source files with translatable text. The template is extracted with:
#   xgettext --language=Rust --from-code=UTF-8 --keyword=tr --keyword=ntr:1,2 \
#     --keyword=n_ --add-comments=TRANSLATORS --package-name=linux-image-writer \
#     --files-from=po/POTFILES.in -o po/linux-image-writer.pot
# and merged into each language with: msgmerge --update po/<lang>.po po/linux-image-writer.pot
src/bin/linux-image-writer/text.rs
src/bin/linux-image-writer/window.rs
